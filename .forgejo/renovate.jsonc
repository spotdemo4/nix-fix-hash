{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "forgejo",
  "endpoint": "https://trev.zip/api/v1",
  "repositories": ["llc/nix-fix-hash"],

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "prHourlyLimit": 0,
  "nix": {
    "enabled": true
  },
  // fix PRs for vulnerable direct dependencies, from osv.dev.
  // transitive vulnerabilities are reported by the vulnerable workflow
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"] // sunday
  },
  "customManagers": [
    {
      // track the rustc in nixpkgs-unstable, which builds this project
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Cargo\\.toml$/"],
      "matchStrings": ["rust-version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "rust",
      "packageNameTemplate": "nix_unstable/rustc",
      "datasourceTemplate": "repology",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"]
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rust"],
      "addLabels": ["rust"]
    }
  ]
}
